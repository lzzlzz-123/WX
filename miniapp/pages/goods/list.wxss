.search{height:78rpx;background:#fff;border-radius:17rpx;padding:0 22rpx;display:flex;align-items:center;color:#91a0aa;font-size:32rpx}.search input{font-size:23rpx;flex:1;margin-left:10rpx}.tabs{white-space:nowrap;margin:28rpx 0 15rpx;height:56rpx}.tabs text{display:inline-block;margin-right:42rpx;height:49rpx;line-height:42rpx;color:#8fa0aa;font-size:23rpx}.tabs text.active{color:#237fc2;font-weight:700;border-bottom:5rpx solid #318fd0}.count{padding:13rpx 0}.goods{display:flex;gap:18rpx;padding:18rpx}.goods-cover{width:175rpx;height:175rpx;border-radius:13rpx;background:linear-gradient(145deg,#7899aa,#c5d2d6);color:#fff;display:grid;place-items:center;font-size:27rpx;font-weight:700}.goods-info{display:flex;flex-direction:column;flex:1;min-width:0}.goods-name{font-size:24rpx;color:#294a5d;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:5rpx 0 10rpx}.stock{color:#4ca879;font-size:19rpx;margin-top:12rpx}.goods-foot{display:flex;justify-content:space-between;align-items:flex-end;margin-top:auto}.goods-foot button{margin:0;background:#2e8ecd;color:#fff;border-radius:50%;width:48rpx;height:48rpx;line-height:44rpx;padding:0;font-size:35rpx}.price{color:#e2704f;font-size:28rpx;font-weight:700}.price small{font-size:17rpx;color:#9ca8af;font-weight:400}
