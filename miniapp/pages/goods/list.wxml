<view class="page"><view class="search">⌕ <input placeholder="搜索商品、规格或品牌" bindinput="onSearch" /></view><scroll-view scroll-x class="tabs"><text wx:for="{{categories}}" wx:key="*this" data-index="{{index}}" class="{{active === index ? 'active' : ''}}" bindtap="selectCategory">{{item}}</text></scroll-view><view class="count muted">{{goods.length}} 个商品</view><view wx:for="{{goods}}" wx:key="id" class="goods card"><view class="goods-cover">建材</view><view class="goods-info"><text class="goods-name">{{item.name}}</text><text class="muted">{{item.spec}}</text><text class="stock">{{item.stock}}</text><view class="goods-foot"><text class="price">¥ {{item.price}}<text class="unit">/{{item.unit}}</text></text><button data-id="{{item.id}}" data-name="{{item.name}}" bindtap="add">+</button></view></view></view></view>
