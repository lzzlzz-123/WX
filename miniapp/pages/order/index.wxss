.form-title{display:block;font-size:29rpx;font-weight:700;color:#28495b;margin-bottom:18rpx}.field{min-height:82rpx;border-bottom:1px solid #edf1f3;display:flex;align-items:center;gap:12rpx}.field>text:first-child{width:145rpx;color:#5b7482;font-size:23rpx}.field input{flex:1;font-size:22rpx}.area{align-items:flex-start;padding:14rpx 0}.area textarea{flex:1;height:100rpx;font-size:22rpx}.submit{margin-top:28rpx;background:#2e8ecd;color:#fff;border-radius:16rpx;height:82rpx;line-height:82rpx;font-size:27rpx}.hint{display:block;text-align:center;color:#a1adb4;font-size:18rpx;margin-top:13rpx}
