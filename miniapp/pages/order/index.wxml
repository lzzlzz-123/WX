<view class="page"><view class="card" wx:if="{{mode === 'inquiry'}}"><text class="form-title">告诉我们您的采购需求</text><view class="field"><text>商品名称</text><input placeholder="例如：HRB400E 螺纹钢" bindinput="onProduct" /></view><view class="field"><text>采购数量</text><input type="number" placeholder="请输入数量" bindinput="onQuantity" /><text class="muted">吨</text></view><view class="field area"><text>交货地址</text><textarea placeholder="请输入项目所在地和详细地址" bindinput="onAddress"></textarea></view><view class="field area"><text>补充说明</text><textarea placeholder="品牌、规格、交期等特殊要求" bindinput="onRemark"></textarea></view></view><view class="card" wx:else><text class="form-title">确认收货与配送</text><view wx:for="{{items}}" wx:key="id" class="field"><text>{{item.product.name}}</text><text>{{item.quantity}} {{item.product.unit}}</text></view><view class="field"><text>商品金额</text><text>¥ {{total}}</text></view><view class="field area"><text>收货地址</text><text wx:if="{{address}}">{{address.receiverName}} {{address.receiverPhone}} {{address.detailAddress}}</text><view wx:else><input placeholder="收货人姓名" bindinput="onReceiverName" /><input type="number" placeholder="手机号" bindinput="onReceiverPhone" /><textarea placeholder="详细地址" bindinput="onReceiverAddress"></textarea></view></view><view class="field area"><text>订单备注</text><textarea placeholder="选填" bindinput="onRemark"></textarea></view></view><button class="submit" bindtap="submit">{{mode === 'inquiry' ? '提交询价单' : '提交订单'}}</button><text class="hint">{{mode === 'inquiry' ? '报价将在 2 小时内反馈' : '提交即代表同意采购服务协议'}}</text></view>
