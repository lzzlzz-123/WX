.tabs{display:flex;white-space:nowrap;margin-bottom:18rpx}
.tab{display:inline-block;padding:14rpx 26rpx;font-size:25rpx;color:#5b7482;border-radius:30rpx}
.tab.active{background:#1d4056;color:#fff;font-weight:700}
.empty{display:flex;flex-direction:column;align-items:center;gap:16rpx;padding:120rpx 0}
.empty-icon{font-size:70rpx}
.order{padding:24rpx}
.order-head{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #edf1f3;padding-bottom:16rpx}
.order-no{font-size:25rpx;font-weight:700;color:#28495b}
.status{font-size:22rpx;color:#e67e22;font-weight:700}
.status-COMPLETED{color:#27ae60}
.status-CANCELLED{color:#91a0aa}
.status-SHIPPED,.status-DELIVERING{color:#2e8ecd}
.order-body{display:flex;flex-direction:column;gap:8rpx;padding:16rpx 0}
.order-foot{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #edf1f3;padding-top:16rpx}
.amount{font-size:23rpx;color:#5b7482}
.amount-value{font-size:30rpx;font-weight:700;color:#d35400}
.ops{display:flex;align-items:center;gap:16rpx}
.btn{margin:0;font-size:23rpx;border-radius:30rpx;padding:0 26rpx;height:56rpx;line-height:56rpx}
.btn.ghost{background:#f4f7f9;color:#5b7482}
.btn.primary{background:#2e8ecd;color:#fff}
.center{display:block;text-align:center;padding:24rpx 0}
