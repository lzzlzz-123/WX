<view class="page"><view class="profile card" bindtap="openProfile"><image wx:if="{{avatarUrl}}" class="avatar avatar-img" src="{{avatarUrl}}" mode="aspectFill" /><view wx:else class="avatar">{{profile.nickname.slice(0, 1)}}</view><view><text class="name">{{profile.nickname}}</text><text class="muted">{{profile.phone || '点击完善头像和昵称'}}</text></view></view><view class="credit"><text>企业采购额度</text><text class="credit-value">¥ 500,000</text><text class="muted" bindtap="openAddresses">默认地址：{{address}}</text></view><view class="card"><view class="row" bindtap="openOrders" data-status=""><text>我的订单</text><text class="muted">全部订单 ›</text></view><view class="order-status"><view data-status="PENDING_PAYMENT" bindtap="openOrders"><text>{{counts.pendingPayment}}</text><text class="muted">待付款</text></view><view data-status="PENDING_SHIPMENT" bindtap="openOrders"><text>{{counts.pendingShipment}}</text><text class="muted">待发货</text></view><view data-status="SHIPPED" bindtap="openOrders"><text>{{counts.shipping}}</text><text class="muted">配送中</text></view><view data-status="COMPLETED" bindtap="openOrders"><text>{{counts.completed}}</text><text class="muted">已完成</text></view></view></view><view class="card menu"><view class="row" bindtap="openProfile"><text>头像与昵称</text><text class="muted">›</text></view><view class="row" bindtap="openInquiries"><text>询价报价</text><text class="muted">›</text></view><view class="row" bindtap="openAddresses"><text>收货地址</text><text class="muted">›</text></view><view class="row" bindtap="openInvoices"><text>发票管理</text><text class="muted">›</text></view></view></view>
