.profile{display:flex;align-items:center;gap:18rpx}.avatar{width:88rpx;height:88rpx;border-radius:50%;background:#d9ebf7;color:#2875a8;display:grid;place-items:center;font-size:34rpx;font-weight:700}.avatar-img{display:block;padding:0}.profile .name{display:block;font-size:30rpx;font-weight:700;color:#213e51;margin-bottom:8rpx}.credit{background:#1d4056;border-radius:19rpx;padding:25rpx;color:#c2d4dd;display:flex;flex-direction:column;gap:8rpx;margin-bottom:18rpx}.credit-value{font-size:36rpx;color:#fff;font-weight:700}.row{height:75rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #edf1f3;color:#405d6b;font-size:23rpx}.row:last-child{border-bottom:0}.order-status{display:flex;justify-content:space-around;padding-top:20rpx}.order-status view{display:flex;flex-direction:column;align-items:center;gap:8rpx}.order-status view>text:first-child{font-size:27rpx;color:#315568;font-weight:700}.menu{padding-top:0;padding-bottom:0}
