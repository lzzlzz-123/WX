.home-head{display:flex;justify-content:space-between;align-items:flex-start;padding:25rpx 0 28rpx}.greeting{display:block;font-size:34rpx;font-weight:700;color:#18364a;margin-bottom:9rpx}.notice{background:#fff;border-radius:20rpx;padding:17rpx 20rpx;color:#5e7a8c;font-size:21rpx}.search{height:78rpx;line-height:78rpx;background:#fff;border-radius:17rpx;padding:0 22rpx;color:#92a1aa;font-size:30rpx}.search text{font-size:22rpx;margin-left:12rpx}.hero{height:280rpx;margin:24rpx 0;border-radius:20rpx;background:#1c4056;color:#fff;padding:30rpx;box-sizing:border-box}.hero-kicker{color:#83bddc;font-size:20rpx;letter-spacing:3rpx}.hero-title{display:block;font-size:40rpx;line-height:1.25;font-weight:700;margin:12rpx 0}.hero-note{display:block;color:#a9c1ce;font-size:19rpx}.hero button{margin:18rpx 0 0 0;background:#42a1df;color:#fff;font-size:21rpx;width:155rpx;height:54rpx;line-height:54rpx}.section-title{display:flex;justify-content:space-between;align-items:center;margin:30rpx 0 18rpx;font-size:29rpx;font-weight:700;color:#244357}.category-list{display:flex;justify-content:space-between}.category{display:flex;flex-direction:column;align-items:center;color:#66808e;font-size:20rpx}.category-icon{width:74rpx;height:74rpx;border-radius:22rpx;background:#e6f3fb;color:#318cca;display:grid;place-items:center;font-size:27rpx;font-weight:700;margin-bottom:10rpx}.product{display:inline-flex;width:44%;vertical-align:top;margin-right:2%;padding:14rpx;box-sizing:border-box;flex-direction:column}.product-cover{height:150rpx;border-radius:12rpx;background:linear-gradient(145deg,#7899aa,#c5d2d6);display:grid;place-items:center;color:#fff;font-size:28rpx;font-weight:700;margin-bottom:15rpx}.product-name{font-size:22rpx;color:#315064;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:7rpx}.price{color:#e16f4b;font-size:28rpx;font-weight:700;margin-top:13rpx}.price small{font-size:17rpx;color:#9ca8af;font-weight:400}
