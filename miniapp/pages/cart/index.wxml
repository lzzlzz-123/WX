<view class="page"><view class="title">采购车</view><view wx:if="{{items.length}}"><view wx:for="{{items}}" wx:key="id" class="cart-item card"><view class="cover">建材</view><view class="info"><text class="name">{{item.name}}</text><text class="muted">{{item.spec}}</text><view class="cart-foot"><text class="price">¥ {{item.price}}<text class="unit">/{{item.unit}}</text></text><text class="muted">数量 {{item.qty}}</text></view></view></view></view><view wx:else class="empty">采购车还是空的</view><view class="bottom"><text>合计 ¥ {{total}}</text><button bindtap="checkout">去结算</button></view></view>
