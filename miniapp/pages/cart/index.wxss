.title{font-size:36rpx;font-weight:700;color:#1f3c50;padding:25rpx 0 28rpx}.cart-item{display:flex;gap:18rpx;padding:18rpx}.cover{width:140rpx;height:140rpx;border-radius:12rpx;background:linear-gradient(145deg,#7f9fae,#cbd6d9);color:#fff;display:grid;place-items:center;font-size:23rpx}.info{display:flex;flex-direction:column;flex:1}.name{font-size:24rpx;color:#2c4b5d;font-weight:700;margin:5rpx 0 9rpx}.cart-foot{display:flex;justify-content:space-between;align-items:flex-end;margin-top:auto}.price{font-size:28rpx;color:#e16f4b;font-weight:700}.price small{font-size:17rpx;color:#9ca8af;font-weight:400}.bottom{position:fixed;left:0;right:0;bottom:0;background:#fff;padding:20rpx 30rpx;display:flex;justify-content:space-between;align-items:center;box-shadow:0 -8rpx 24rpx rgba(20,50,70,.05);font-size:24rpx;color:#e16f4b}.bottom button{margin:0;background:#2e8ecd;color:#fff;border-radius:28rpx;height:58rpx;line-height:58rpx;padding:0 39rpx;font-size:22rpx}
